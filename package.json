{
  "name": "app-assets-view",
  "version": "1.0.0",
  "description": "Personal self-hosted media explorer — Netflix for local files",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "dotenv -- astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "HOST=0.0.0.0 dotenv -- node ./dist/server/entry.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/node": "^10.1.4",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.4.6",
    "chokidar": "^5.0.0",
    "es-module-lexer": "^2.3.0",
    "exifr": "^7.1.3",
    "mime-types": "^3.0.2",
    "pdfjs-dist": "^6.0.227",
    "sharp": "^0.35.1",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.9.0",
    "dotenv-cli": "^11.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  }
}
